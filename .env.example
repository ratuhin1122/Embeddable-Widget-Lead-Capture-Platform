# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database ──
DATABASE_URL=postgres://widget_user:widget_pass@localhost:5432/widget_db

# ── Auth ──
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# ── Geo Providers ──
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co

# ── Email (Mailpit local catcher) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@widget-platform.local

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ── CORS ──
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Public Base URL (optional) ──
# Used in embed snippets. Falls back to http://localhost:PORT if not set.
# PUBLIC_BASE_URL=https://widgets.example.com
